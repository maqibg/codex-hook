# codex-hook 配置
# 将此文件复制为 .env 放在 exe 同目录（target/release/.env）

# 调试模式（true=输出详细日志到 stderr）
DEBUG=false

# Telegram 代理（支持自定义端口；HTTP / SOCKS5）
TELEGRAM_PROXY_URL=http://127.0.0.1:7890
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=5000

# 未设置渠道专用代理时，兼容旧版配置回退到 HTTPS_PROXY / HTTP_PROXY
# HTTPS_PROXY=http://127.0.0.1:7890

# 事件和消息
EVENT_COMPLETE=true
EVENT_CONFIRM=true
EVENT_WARNING=true
MESSAGE_INCLUDE_RAW=true
MESSAGE_RAW_MAX_CHARS=500

# AI 摘要（OpenAI 兼容 API，失败自动降级本地算法）
AI_ENABLE=true
AI_API_KEY=sk-xxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_CHARS=500
AI_TIMEOUT_MS=5000
# AI_PROXY_URL=
# 兼容旧版：未设置 AI_MAX_OUTPUT_CHARS 时读取 AI_MAX_WORDS
# AI_MAX_WORDS=500

# AI 摘要提示词（可自定义覆盖默认值）
# system prompt：定义 AI 角色和输出格式要求
# AI_SYSTEM_PROMPT=你是摘要助手。要求：\n1. 输出简洁中文摘要，以浓缩易懂为首要目标，不必写满字数上限\n2. 使用纯文本，禁止使用 Markdown 格式（不要用 # ** `` 等标记）\n3. 如有多个要点用序号列出，每个序号独占一行\n4. 不加任何前缀（如"摘要："）和后缀
# user prompt：{max_output_chars} 和 {content} 为占位符；兼容旧占位符 {max_words}
# AI_USER_PROMPT=用中文总结以下内容，不超过{max_output_chars}字，突出关键操作和结果：\n\n{content}

# Windows 桌面通知
WIN_NOTIFY_ENABLE=true

# 语音播报（Windows TTS）
VOICE_ENABLE=true
VOICE_STOP=Codex任务完成
VOICE_PERMISSION=需要权限确认

# 飞书可使用独立代理；留空时回退到 HTTPS_PROXY / HTTP_PROXY
# FEISHU_PROXY_URL=
FEISHU_TIMEOUT_MS=5000

# Telegram 通知（可配多个实例：TG_1_*、TG_2_*...）
# 获取 Token：Telegram 搜索 @BotFather → /newbot
# 获取 Chat ID：Telegram 搜索 @userinfobot → 发消息查看
TG_1_ENABLE=true
TG_1_NAME=通知1
TG_1_TOKEN=<Token>
TG_1_CHAT_ID=<Chat ID>

# 飞书 Webhook 通知（可配多个实例：FS_1_*、FS_2_*...）
# 获取 URL：飞书群 → 设置 → 群机器人 → 添加 → 自定义机器人 → 复制 Webhook URL
# FS_1_ENABLE=true
# FS_1_NAME=飞书通知
# FS_1_WEBHOOK_URL=<Webhook URL>
